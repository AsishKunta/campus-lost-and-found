DATABASE_URL=postgresql:///campus_lost_found
PORT=3001
FRONTEND_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:5500,http://127.0.0.1:5500
SESSION_TTL_MS=28800000
REMEMBERED_SESSION_TTL_MS=2592000000
# Vercel frontend -> Render API is cross-site and requires None + Secure.
# Use lax only when frontend and API are served from the same site.
SESSION_COOKIE_SAME_SITE=none
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
TRUST_PROXY_HOPS=0

# Password recovery. Production delivery uses Resend; tokens are never returned
# by the API or logged. The frontend URL must point to the deployed static app.
PASSWORD_RESET_TTL_MS=1800000
PASSWORD_RESET_RATE_LIMIT_MAX=5
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=900000
PASSWORD_RESET_EMAIL_PROVIDER=disabled
PASSWORD_RESET_FRONTEND_URL=http://localhost:5500
PASSWORD_RESET_FROM_EMAIL=
RESEND_API_KEY=

# Optional server-side AI description assistant. Leave disabled to preserve the
# normal report workflow without an external provider.
AI_DESCRIPTION_PROVIDER=disabled
OPENAI_API_KEY=
AI_DESCRIPTION_MODEL=gpt-5.6-luna
AI_DESCRIPTION_ENDPOINT=https://api.openai.com/v1/responses
AI_DESCRIPTION_MAX_LENGTH=5000
AI_DESCRIPTION_RATE_LIMIT_MAX=10
AI_DESCRIPTION_RATE_LIMIT_WINDOW_MS=900000

# Local-only shortcut. This is ignored when NODE_ENV=production.
DEV_AUTH_BYPASS=false
DEMO_DOMAIN_ROLES=true
DEV_AUTH_EMAIL=development-user@campus.local
DEV_AUTH_NAME=Local Development User
